# mock = keyword stub, no key needed. llm = OpenAI via Pydantic AI.
EXTRACT_MODE=mock
OPENAI_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=

# memory = in-process store. supabase = Postgres via Supabase.
STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

PACK=ng-lagos
REF_CODE_SECRET=change-me-to-a-long-random-string
ANALYST_PASSWORD=change-me
# Local development only. Production must leave this off so unverified content is never sent.
ALLOW_UNVERIFIED=false
DEMO_MODE=true
