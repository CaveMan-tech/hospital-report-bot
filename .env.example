# mock = keyword stub, no key needed. llm = OpenAI via Pydantic AI.
EXTRACT_MODE=mock
OPENAI_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=

# memory = in-process store. postgres = any Postgres (Railway injects DATABASE_URL).
STORE=memory
DATABASE_URL=

# Default pack, and every pack this deployment serves (/?pack=<id> switches).
# Voice notes (speech to text). Needs OPENAI_API_KEY. Audio is transcribed and discarded.
VOICE_ENABLED=false
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

PACK=ng-lagos
PACKS=ng-lagos,ke-nairobi
REF_CODE_SECRET=change-me-to-a-long-random-string
ANALYST_PASSWORD=change-me
# Local development only. Production must leave this off so unverified content is never sent.
ALLOW_UNVERIFIED=false
DEMO_MODE=true

# Telegram channel. Leave the token empty to keep it off. Secret: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
